{
  "version": 2,
  "name": "instaweb-brand",
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/ad-offer", "dest": "/ad-offer.html" },
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/find-leads", "dest": "/find-leads.html" },
    { "src": "/build-demo", "dest": "/build-demo.html" },
    { "src": "/outreach", "dest": "/outreach.html" },
    { "src": "/quick-fix", "dest": "/quick-fix.html" },
    { "src": "/data/leads_data.js", "dest": "/data/leads_data.js" },
    { "src": "/data/leads_stats.json", "dest": "/data/leads_stats.json" },
    { "src": "/data", "dest": "/data.html" },
    { "src": "/caller-pro", "dest": "/caller-pro.html" },
    { "src": "/caller", "dest": "/caller.html" },
    { "src": "/demo/(.*)", "dest": "/data/demos/mass_output/$1.html" },
    { "src": "/preview", "dest": "/preview.html" },
    { "src": "/partners", "dest": "/agency-partners.html" },
    { "src": "/agency-partners", "dest": "/agency-partners.html" },
    { "src": "/quarantine", "dest": "/quarantine.html" },
    { "src": "/buyer-shortlist", "dest": "/buyer-shortlist.html" },
