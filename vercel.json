    { "src": "/api/lead-intake/(.*)", "dest": "/api/lead-intake.js" }
  ],
  "redirects": [
    { "source": "/buy/gbp", "destination": "https://buy.stripe.com/28EeVd3fQ6567h285ldjO04", "permanent": true },
    { "source": "/buy/leads", "destination": "https://buy.stripe.com/eVq5kDg2CalmateetJdjO06", "permanent": true },
    { "source": "/buy/leads-big", "destination": "https://buy.stripe.com/4gM6oHbMmctueJu85ldjO07", "permanent": true },
    { "source": "/buy/setup", "destination": "https://buy.stripe.com/28E5kD9Ee51244Q4T9djO03", "permanent": true }
  ],
  "functions": {
    "api/stats.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/dashboard-stats.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/sync-calls.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/caller/leads.js": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/lead-intake.js": {
      "memory": 256,
      "maxDuration": 30
    }
  }
}
